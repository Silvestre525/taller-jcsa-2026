{
  // Deploy del front como Worker con assets estáticos (Cloudflare Workers Builds).
  "name": "taller-frontend",
  "compatibility_date": "2026-10-01",
  // URL pública *.workers.dev y URLs de preview para ramas que no son main
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    // Es una SPA: rutas como /tareas tienen que devolver index.html
    "not_found_handling": "single-page-application"
  }
}
